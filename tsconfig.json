{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "jsxImportSource": "astro",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "types": ["astro/client"]
  },
  "include": ["**/*", ".astro/types.d.ts"],
  "exclude": ["dist", "node_modules"]
}