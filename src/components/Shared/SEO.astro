---
import { personalInfo } from "../../data/portfolio";
import logo from "../../assets/logo.png";
import coverImage from "../../assets/projects/portfolio/cover.webp";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageWidth?: string;
  imageHeight?: string;
  canonicalURL?: string;
  type?: string;
}

const {
  title = personalInfo.name,
  description = "Portfolio de Marcos Burdaspar - Ingeniero Informático Full Stack",
  image = coverImage.src,
  imageWidth,
  imageHeight,
  canonicalURL = Astro.url.href,
  type = "website",
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.origin : "";
const imageUrl = image.startsWith("http") ? image : `${siteUrl}${image}`;

// Default dimensions only if using the default image
const finalWidth = imageWidth || (image === coverImage.src ? "1056" : undefined);
const finalHeight = imageHeight || (image === coverImage.src ? "1056" : undefined);
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/png" href={logo.src} />
<link rel="apple-touch-icon" href={logo.src} />
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageUrl} />
{finalWidth && <meta property="og:image:width" content={finalWidth} />}
{finalHeight && <meta property="og:image:height" content={finalHeight} />}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={imageUrl} />
