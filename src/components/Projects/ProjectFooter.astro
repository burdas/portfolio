---
import { Icon } from "astro-icon/components";

interface Props {
  prevProject?: {
    slug: string;
    data: {
      name: string;
    };
  } | null;
  nextProject?: {
    slug: string;
    data: {
      name: string;
    };
  } | null;
  url?: string;
  repo?: string;
}

const { prevProject, nextProject, url, repo } = Astro.props;
---

<footer
  class="mt-32 pt-16 border-t border-white/5"
  data-reveal
  data-reveal-type="fade-up"
>
  <div class="grid grid-cols-1 lg:grid-cols-3 items-center gap-12 lg:gap-8">
    <!-- Prev -->
    <div class="order-2 lg:order-1">
      {
        prevProject ? (
          <a href={`/projects/${prevProject.slug}`} class="group block">
            <span class="text-[10px] font-bold tracking-[0.2em] uppercase text-gray-500 block mb-2">
              Proyecto Anterior
            </span>
            <div class="flex items-center gap-3">
              <Icon
                name="arrow-left"
                class="w-5 h-5 text-gray-500 group-hover:text-white transition group-hover:-translate-x-1"
              />
              <span class="text-lg font-bold text-gray-400 group-hover:text-white transition line-clamp-1">
                {prevProject.data.name}
              </span>
            </div>
          </a>
        ) : (
          <div class="hidden lg:block opacity-0 pointer-events-none text-left">Empty</div>
        )
      }
    </div>

    <!-- Live & Repo CTA -->
    <div class="order-1 lg:order-2 flex flex-col items-center gap-6 py-8 lg:py-0 border-y lg:border-none border-white/5">
      <div class="flex flex-wrap justify-center gap-4">
        {
          url && (
            <a
              href={url}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 px-6 py-3 bg-indigo-600 text-white text-sm font-bold rounded-xl hover:bg-indigo-500 transition hover:scale-105 shadow-lg shadow-indigo-500/20"
            >
              <Icon name="play" class="w-4 h-4" />
              Live Demo
            </a>
          )
        }
        {
          repo && (
            <a
              href={repo}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 px-6 py-3 bg-white/5 border border-white/10 text-white text-sm font-bold rounded-xl hover:bg-white/10 transition"
            >
              <Icon name="github" class="w-4 h-4" />
              Código
            </a>
          )
        }
      </div>
      
      <!-- Socials -->
      <div class="flex items-center gap-6">
        <a
          href="mailto:marcos@burdaspar.com"
          class="text-gray-500 hover:text-white transition"
          aria-label="Email"
        >
          <Icon name="mail" class="w-5 h-5" />
        </a>
        <a
          href="https://linkedin.com/in/burdaspar"
          target="_blank"
          class="text-gray-500 hover:text-white transition"
          aria-label="LinkedIn"
        >
          <Icon name="linkedin" class="w-5 h-5" />
        </a>
        <a
          href="https://github.com/burdaspar"
          target="_blank"
          class="text-gray-500 hover:text-white transition"
          aria-label="GitHub"
        >
          <Icon name="github" class="w-5 h-5" />
        </a>
      </div>
    </div>

    <!-- Next -->
    <div class="order-3 text-right">
      {
        nextProject ? (
          <a href={`/projects/${nextProject.slug}`} class="group block">
            <span class="text-[10px] font-bold tracking-[0.2em] uppercase text-gray-500 block mb-2">
              Siguiente Proyecto
            </span>
            <div class="flex items-center justify-end gap-3">
              <span class="text-lg font-bold text-gray-400 group-hover:text-white transition line-clamp-1">
                {nextProject.data.name}
              </span>
              <Icon
                name="arrow-right"
                class="w-5 h-5 text-gray-500 group-hover:text-white transition group-hover:translate-x-1"
              />
            </div>
          </a>
        ) : (
          <div>
            <span class="text-[10px] font-bold tracking-[0.2em] uppercase text-gray-500 block mb-2">
              Siguiente Proyecto
            </span>
            <span class="text-lg font-bold text-gray-600">Próximamente...</span>
          </div>
        )
      }
    </div>
  </div>
</footer>
