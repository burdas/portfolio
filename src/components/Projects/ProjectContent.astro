---
import GlassCard from "@/src/components/Shared/GlassCard.astro";

interface Props {
  fullDescription: string;
  challenges: string[];
  solutions: string[];
}

const { fullDescription, challenges, solutions } = Astro.props;
---

<section class="mb-12" transition:animate="slide">
  <div class="grid md:grid-cols-3 gap-8">
    <div class="col-span-2">
      <div class="flex place-items-center gap-4 mb-6">
        <div
          class="w-12 h-0.5 bg-linear-to-r from-indigo-500 to-transparent"
        >
        </div>
        <h2 class="text-2xl font-bold">Sobre el Proyecto</h2>
      </div>
      <p class="text-gray-300 leading-relaxed mb-8">
        {fullDescription}
      </p>

      <GlassCard>
        <h3 class="text-xl font-bold mb-6">Retos y soluciones</h3>
        <div class="grid grid-cols-2 gap-6">
          {
            challenges.map((challenge, index) => (
              <>
                <div>
                  <p class="text-primary text-xs uppercase tracking-wider mb-3 font-semibold">
                    El reto
                  </p>
                  <p class="text-gray-400 text-sm">{challenge}</p>
                </div>
                <div>
                  <p class="text-indigo-400 text-xs uppercase tracking-wider mb-3 font-semibold">
                    La solución
                  </p>
                  <p class="text-gray-400 text-sm">
                    {solutions[index]}
                  </p>
                </div>
                {index < challenges.length - 1 && (
                  <div class="col-span-2 h-px bg-zinc-500/50" />
                )}
              </>
            ))
          }
        </div>
      </GlassCard>
    </div>

    <slot name="sidebar" />
  </div>
</section>
