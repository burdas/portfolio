---
import { Icon } from "astro-icon/components";

interface Props {
  name: string;
  description: string;
  url?: string;
  repo?: string;
  projectId: string;
}

const { name, description, url, repo, projectId } = Astro.props;
---

<header class="mb-12" transition:animate="slide" data-reveal data-reveal-type="fade-up">
  <h1
    class="text-5xl md:text-6xl font-bold mb-4"
    transition:name={`project-title-${projectId}`}
  >
    {name}
  </h1>
  <p
    class="text-xl text-gray-400 mb-8 max-w-2xl"
    transition:name={`project-description-${projectId}`}
  >
    {description}
  </p>
  <div class="flex gap-4 flex-wrap">
    {
      url && (
        <a
          href={url}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 px-6 py-3 bg-violet-600 text-white font-medium rounded-lg hover:bg-violet-500 transition hover:scale-105"
        >
          <Icon name="external-link" class="w-5 h-5" />
          Ver proyecto
        </a>
      )
    }
    {
      repo && (
        <a
          href={repo}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 px-6 py-3 border border-white/20 text-white font-medium rounded-lg hover:bg-white/10 transition"
        >
          <Icon name="github" class="w-5 h-5" />
          Código
        </a>
      )
    }
  </div>
</header>
