---
import CloseIcon from "@/src/icons/close.svg";
import ArrowLeftIcon from "@/src/icons/arrow-left.svg";
import ArrowRightIcon from "@/src/icons/arrow-right.svg";

interface GalleryItem {
  image: string;
  description: string;
}

interface Props {
  images: GalleryItem[];
  slug: string;
}

const { images, slug } = Astro.props;
---

<div
  id="gallery-lightbox"
  class="fixed inset-0 z-50 hidden bg-black/95 overflow-hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Galería de imágenes"
>
  <header
    class="fixed top-0 inset-x-0 z-30 flex items-center justify-between px-4 py-3 bg-gradient-to-b from-black/60 to-transparent"
  >
    <span id="lightbox-counter" class="text-white font-medium"></span>
    <button
      id="lightbox-close"
      class="text-white/70 hover:text-white transition-colors p-2 cursor-pointer"
      aria-label="Cerrar"
    >
      <CloseIcon class="w-8 h-8" />
    </button>
  </header>

  <button
    id="lightbox-prev"
    class="fixed left-4 top-1/2 -translate-y-1/2 text-white/70 hover:text-white transition-colors p-2 cursor-pointer z-40"
    aria-label="Imagen anterior"
  >
    <ArrowLeftIcon class="w-10 h-10" />
  </button>

  <button
    id="lightbox-next"
    class="fixed right-4 top-1/2 -translate-y-1/2 text-white/70 hover:text-white transition-colors p-2 cursor-pointer z-40"
    aria-label="Imagen siguiente"
  >
    <ArrowRightIcon class="w-10 h-10" />
  </button>

  <div
    id="lightbox-scroll"
    class="w-full h-full overflow-y-hidden flex items-center justify-center"
  >
    <div
      id="lightbox-content"
      class="flex items-center justify-center w-full min-h-full py-[72px] px-4"
    >
      <img
        id="lightbox-img"
        class="max-w-full max-h-[calc(100vh-80px)] object-contain rounded-lg select-none cursor-zoom-in"
        src=""
        alt=""
      />
    </div>
  </div>

  <p
    id="lightbox-caption"
    class="fixed bottom-6 inset-x-0 text-white/80 text-center text-sm px-4 pointer-events-none z-30"
  >
  </p>

  <div
    id="zoom-hint"
    class="fixed bottom-14 left-1/2 -translate-x-1/2 z-40 bg-black/60 backdrop-blur-sm text-white/90 text-xs px-4 py-2 rounded-full pointer-events-none transition-opacity duration-300"
  >
    click to zoom
  </div>
</div>

<script is:inline define:vars={{ images }}>
  (function () {
    const lightbox = document.getElementById("gallery-lightbox");
    const scroll = document.getElementById("lightbox-scroll");
    const content = document.getElementById("lightbox-content");
    const imgEl = document.getElementById("lightbox-img");
    const captionEl = document.getElementById("lightbox-caption");
    const counterEl = document.getElementById("lightbox-counter");
    const hintEl = document.getElementById("zoom-hint");

    let currentIndex = 0;
    let isZoomed = false;

    const getTriggerSrc = (index) => {
      const img = document
        .querySelectorAll(".gallery-trigger")
        [index]?.querySelector("img");
      return img?.src ?? "";
    };

    const isZoomable = () => imgEl.naturalWidth / imgEl.naturalHeight < 1.0;

    function applyZoom(zoom) {
      isZoomed = zoom;

      imgEl.style.transition = "transform 0.4s ease-out";
      imgEl.style.transformOrigin = "top center";

      if (zoom) {
        imgEl.style.transform = "scale(3)";
        imgEl.style.cursor = "zoom-out";
        scroll.style.overflowY = "auto";
        scroll.style.alignItems = "flex-start";
      } else {
        imgEl.style.transform = "scale(1)";
        imgEl.style.cursor = "zoom-in";
        scroll.style.overflowY = "hidden";
        scroll.style.alignItems = "";
        scroll.scrollTop = 0;
      }

      if (hintEl) {
        hintEl.textContent = zoom ? "click to reduce" : "click to zoom";
        hintEl.style.opacity = zoom ? "0" : "1";
      }
    }

    function toggleZoom(e) {
      e.stopPropagation();
      if (!isZoomable()) return;
      applyZoom(!isZoomed);
    }

    function openLightbox(index, src) {
      currentIndex = index;
      isZoomed = false;

      imgEl.style.transition = "none";
      imgEl.style.transform = "scale(1)";
      imgEl.style.transformOrigin = "top center";
      imgEl.style.cursor = "zoom-in";
      scroll.style.overflowY = "hidden";
      scroll.style.alignItems = "";
      scroll.scrollTop = 0;

      imgEl.src = src;
      imgEl.alt = images[index].description ?? "";
      imgEl.onload = () => {
        if (!isZoomable()) {
          hintEl.style.display = "none";
          imgEl.style.cursor = "default";
        } else {
          hintEl.style.display = "";
        }
      };

      if (captionEl) captionEl.textContent = images[index].description ?? "";
      if (counterEl) counterEl.textContent = `${index + 1} / ${images.length}`;

      lightbox.classList.replace("hidden", "flex");
      document.body.style.overflow = "hidden";
    }

    function closeLightbox() {
      applyZoom(false);
      lightbox.classList.replace("flex", "hidden");
      document.body.style.overflow = "";
    }

    const showPrev = () => {
      const i = (currentIndex - 1 + images.length) % images.length;
      openLightbox(i, getTriggerSrc(i));
    };

    const showNext = () => {
      const i = (currentIndex + 1) % images.length;
      openLightbox(i, getTriggerSrc(i));
    };

    document
      .getElementById("lightbox-close")
      .addEventListener("click", closeLightbox);
    document
      .getElementById("lightbox-prev")
      .addEventListener("click", showPrev);
    document
      .getElementById("lightbox-next")
      .addEventListener("click", showNext);
    imgEl.addEventListener("click", toggleZoom);

    lightbox.addEventListener("click", (e) => {
      if (e.target === lightbox || e.target === scroll || e.target === content)
        closeLightbox();
    });

    document.addEventListener("keydown", (e) => {
      if (!lightbox.classList.contains("flex")) return;
      if (e.key === "Escape") closeLightbox();
      if (e.key === "ArrowLeft") showPrev();
      if (e.key === "ArrowRight") showNext();
    });

    document.querySelectorAll(".gallery-trigger").forEach((trigger, index) => {
      trigger.addEventListener("click", () =>
        openLightbox(index, getTriggerSrc(index)),
      );
    });
  })();
</script>

<style>
  #lightbox-scroll {
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.3) transparent;
  }
  #lightbox-scroll::-webkit-scrollbar {
    width: 6px;
  }
  #lightbox-scroll::-webkit-scrollbar-track {
    background: transparent;
  }
  #lightbox-scroll::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.3);
    border-radius: 3px;
  }
</style>
