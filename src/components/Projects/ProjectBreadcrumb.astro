---
import { Icon } from "astro-icon/components";

interface Props {
  projectName: string;
}

const { projectName } = Astro.props;
---

<nav
  class="mb-4"
  transition:animate="slide"
  data-reveal
  data-reveal-type="fade-down"
>
  <ol class="flex items-center gap-2 text-sm text-gray-500">
    <li>
      <a href="/#projects" class="text-gray-500 hover:text-white transition">
        Proyectos
      </a>
    </li>
    <li>/</li>
    <li class="text-gray-200">{projectName}</li>
  </ol>
</nav>
