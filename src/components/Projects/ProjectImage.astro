---
import { Image } from "astro:assets";

interface Props {
  slug: string;
  imageName?: string;
  showLabel?: boolean;
  class?: string;
  disableTransition?: boolean;
}

const { slug, imageName = "cover.webp", showLabel = false, class: className, disableTransition = false } = Astro.props;

const projectImages = import.meta.glob('/src/assets/projects/*/*.{webp,png,jpg,gif}');
const portfolioImages = import.meta.glob('/src/assets/projects/portfolio/*.{webp,png,jpg,gif}');

const projectImagePath = `/src/assets/projects/${slug}/${imageName}`;
const portfolioImagePath = `/src/assets/projects/portfolio/${imageName}`;

const imageExists = !!projectImages[projectImagePath] || !!portfolioImages[portfolioImagePath];
const imageSrc = projectImages[projectImagePath]
  ? projectImages[projectImagePath]
  : portfolioImages[portfolioImagePath];
---

{
  imageExists ? (
    <Image
      src={imageSrc() as any}
      alt={slug}
      class={`${className} pointer-events-none`}
      {...(!disableTransition && { transition: { name: `project-image-${slug}` } })}
    />
  ) : (
    <div
      class={`w-full h-full bg-white/5 flex items-center justify-center text-gray-500 ${className}`}
    >
      {showLabel && "Imagen no encontrada"}
    </div>
  )
}
