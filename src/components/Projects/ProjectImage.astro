---
import { Image } from "astro:assets";

interface Props {
  slug: string;
  imageName?: string;
  showLabel?: boolean;
  class?: string;
  disableTransition?: boolean;
}

const { slug, imageName = "cover.webp", showLabel = false, class: className, disableTransition = false } = Astro.props;

const PROJECT_IMAGES_PATH = "/src/assets/projects/";

const images = import.meta.glob('/src/assets/projects/*/*.{webp,png,jpg,gif}');

const imagePath = `${PROJECT_IMAGES_PATH}${slug}/${imageName}`;
const imageExists = !!images[imagePath];
---

{
  imageExists ? (
    <Image
      src={images[imagePath]() as any}
      alt={slug}
      class={className}
      {...(!disableTransition && { transition: { name: `project-image-${slug}` } })}
    />
  ) : (
    <div
      class={`w-full h-full bg-white/5 flex items-center justify-center text-gray-500 ${className}`}
    >
      {showLabel && "Imagen no encontrada"}
    </div>
  )
}
