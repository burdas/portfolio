---
import ProjectImage from "@/src/components/Projects/ProjectImage.astro";
import CloseIcon from "@/src/icons/close.svg";
import ArrowLeftIcon from "@/src/icons/arrow-left.svg";
import ArrowRightIcon from "@/src/icons/arrow-right.svg";

interface Props {
  images: string[];
  slug: string;
}

const { images, slug } = Astro.props;
---

<section class="mb-12" transition:animate="slide">
  <div class="flex place-items-center gap-4 mb-6">
    <div class="w-12 h-0.5 bg-linear-to-r from-indigo-500 to-transparent"></div>
    <h2 class="text-2xl font-bold">Galería</h2>
  </div>

  <div class="relative group">
    <button
      id="thumb-prev"
      class="thumb-nav absolute left-2 top-1/2 -translate-y-1/2 z-10 bg-black/50 hover:bg-black/70 text-white p-3 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-300 hidden md:flex items-center justify-center cursor-pointer"
      aria-label="Imagen anterior"
    >
      <ArrowLeftIcon class="w-6 h-6" />
    </button>

    <div
      id="thumbnails-container"
      class="flex gap-4 overflow-x-auto snap-x snap-mandatory pb-2"
    >
      {
        images.map((image, index) => (
          <button
            class="gallery-trigger shrink-0 w-1/3 overflow-hidden rounded-lg aspect-video bg-zinc-800 hover:ring-2 hover:ring-indigo-500 transition-all duration-300 group cursor-pointer snap-start"
            data-index={index}
            aria-label="Ampliar imagen"
          >
            <ProjectImage
              image={image}
              slug={`${slug}-gallery-${index}`}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
              disableTransition={true}
            />
          </button>
        ))
      }
    </div>

    <button
      id="thumb-next"
      class="thumb-nav absolute right-2 top-1/2 -translate-y-1/2 z-10 bg-black/50 hover:bg-black/70 text-white p-3 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-300 hidden md:flex items-center justify-center cursor-pointer"
      aria-label="Imagen siguiente"
    >
      <ArrowRightIcon class="w-6 h-6" />
    </button>
  </div>
</section>

<div
  id="gallery-lightbox"
  class="fixed inset-0 z-50 hidden bg-black/95 backdrop-blur-sm items-center justify-center p-4"
  role="dialog"
  aria-modal="true"
  aria-label="Galería de imágenes"
>
  <button
    id="lightbox-close"
    class="absolute top-4 right-4 text-white/70 hover:text-white transition-colors p-2 cursor-pointer"
    aria-label="Cerrar"
  >
    <CloseIcon class="w-8 h-8" />
  </button>

  <button
    id="lightbox-prev"
    class="absolute left-4 text-white/70 hover:text-white transition-colors p-2 cursor-pointer"
    aria-label="Imagen anterior"
  >
    <ArrowLeftIcon class="w-8 h-8" />
  </button>

  <button
    id="lightbox-next"
    class="absolute right-4 text-white/70 hover:text-white transition-colors p-2 cursor-pointer"
    aria-label="Imagen siguiente"
  >
    <ArrowRightIcon class="w-8 h-8" />
  </button>

  <div id="lightbox-images-container">
    {
      images.map((image, index) => (
        <div class="lightbox-img hidden" data-index={index}>
          <ProjectImage
            image={image}
            slug={`${slug}-lightbox-${index}`}
            class="max-w-full max-h-[85vh] object-contain rounded-lg"
          />
        </div>
      ))
    }
  </div>
</div>

<script define:vars={{ images, slug }}>
  const triggers = document.querySelectorAll(".gallery-trigger");
  const lightbox = document.getElementById("gallery-lightbox");
  const lightboxImages = document.querySelectorAll(".lightbox-img");
  const closeBtn = document.getElementById("lightbox-close");
  const prevBtn = document.getElementById("lightbox-prev");
  const nextBtn = document.getElementById("lightbox-next");

  let currentIndex = 0;

  function openLightbox(index) {
    currentIndex = index;
    updateImage();
    lightbox.classList.remove("hidden");
    lightbox.classList.add("flex");
    document.body.style.overflow = "hidden";
  }

  function closeLightbox() {
    lightbox.classList.add("hidden");
    lightbox.classList.remove("flex");
    document.body.style.overflow = "";
  }

  function updateImage() {
    lightboxImages.forEach((img) => img.classList.add("hidden"));
    const currentImg = lightboxImages[currentIndex];
    currentImg?.classList.remove("hidden");
    currentImg?.classList.add("animate-fade-in");
    setTimeout(() => currentImg?.classList.remove("animate-fade-in"), 300);
  }

  function showPrev() {
    currentIndex =
      (currentIndex - 1 + lightboxImages.length) % lightboxImages.length;
    updateImage();
  }

  function showNext() {
    currentIndex = (currentIndex + 1) % lightboxImages.length;
    updateImage();
  }

  triggers.forEach((trigger, index) => {
    trigger.addEventListener("click", () => openLightbox(index));
  });

  closeBtn?.addEventListener("click", closeLightbox);
  prevBtn?.addEventListener("click", showPrev);
  nextBtn?.addEventListener("click", showNext);

  lightbox?.addEventListener("click", (e) => {
    if (e.target === lightbox) closeLightbox();
  });

  document.addEventListener("keydown", (e) => {
    if (!lightbox.classList.contains("flex")) return;
    if (e.key === "Escape") closeLightbox();
    if (e.key === "ArrowLeft") showPrev();
    if (e.key === "ArrowRight") showNext();
  });

  const thumbnailsContainer = document.getElementById("thumbnails-container");
  const thumbPrevBtn = document.getElementById("thumb-prev");
  const thumbNextBtn = document.getElementById("thumb-next");

  const scrollAmount = thumbnailsContainer?.clientWidth * 0.6 || 200;

  function updateThumbButtons() {
    if (!thumbnailsContainer || !thumbPrevBtn || !thumbNextBtn) return;
    const { scrollLeft, scrollWidth, clientWidth } = thumbnailsContainer;
    thumbPrevBtn.classList.toggle("hidden", scrollLeft <= 10);
    thumbNextBtn.classList.toggle(
      "hidden",
      scrollLeft + clientWidth >= scrollWidth - 10,
    );
  }

  thumbnailsContainer?.addEventListener("scroll", updateThumbButtons);
  updateThumbButtons();

  thumbPrevBtn?.addEventListener("click", () => {
    thumbnailsContainer?.scrollBy({ left: -scrollAmount, behavior: "smooth" });
  });

  thumbNextBtn?.addEventListener("click", () => {
    thumbnailsContainer?.scrollBy({ left: scrollAmount, behavior: "smooth" });
  });
</script>

<style>
  .animate-fade-in {
    animation: fadeIn 0.3s ease-in-out;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: scale(0.95);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  #thumbnails-container {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  #thumbnails-container::-webkit-scrollbar {
    display: none;
  }
</style>
