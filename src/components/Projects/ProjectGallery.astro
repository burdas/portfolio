---
import ProjectImage from "@/src/components/Projects/ProjectImage.astro";
import ArrowLeftIcon from "@/src/icons/arrow-left.svg";
import ArrowRightIcon from "@/src/icons/arrow-right.svg";
import ProjectLightbox from "@/src/components/Projects/ProjectLightbox.astro";

interface GalleryItem {
  image: string;
  description: string;
}

interface Props {
  images: GalleryItem[];
  slug: string;
}

const { images, slug } = Astro.props;
---

<section class="mb-12" transition:animate="slide">
  <div class="flex place-items-center gap-4 mb-6">
    <div class="w-12 h-0.5 bg-linear-to-r from-indigo-500 to-transparent"></div>
    <h2 class="text-2xl font-bold">Galería</h2>
  </div>

  <div class="relative group">
    <button
      id="thumb-prev"
      class="thumb-nav absolute left-2 top-1/2 -translate-y-1/2 z-10 bg-black/50 hover:bg-black/70 text-white p-3 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-300 hidden md:flex items-center justify-center cursor-pointer"
      aria-label="Imagen anterior"
    >
      <ArrowLeftIcon class="w-6 h-6" />
    </button>

    <div
      id="thumbnails-container"
      class="flex gap-4 overflow-x-auto snap-x snap-mandatory pb-2 p-[3px]"
    >
      {
        images.map((item, index) => (
          <button
            class="gallery-trigger group relative shrink-0 w-[calc(33.33%-10.66px)] md:w-[calc(33.33%-10.66px)] overflow-visible rounded-lg aspect-video bg-zinc-800 cursor-pointer snap-start transition-all duration-300"
            data-index={index}
            aria-label="Ampliar imagen"
          >
            <div class="relative w-full h-full overflow-hidden rounded-lg transition-shadow duration-300 hover:shadow-[0_0_0_3px] hover:shadow-indigo-500">
              <ProjectImage
                slug={slug}
                imageName={item.image}
                class="w-full h-full object-contain transition-transform duration-300 group-hover:scale-105 bg-zinc-900"
                disableTransition={true}
              />
            </div>
            <span class="gallery-tooltip absolute bottom-2 left-2 right-2 bg-black/80 text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity duration-200 pointer-events-none text-center">
              {item.description}
            </span>
          </button>
        ))
      }
    </div>

    <button
      id="thumb-next"
      class="thumb-nav absolute right-2 top-1/2 -translate-y-1/2 z-10 bg-black/50 hover:bg-black/70 text-white p-3 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-300 hidden md:flex items-center justify-center cursor-pointer"
      aria-label="Imagen siguiente"
    >
      <ArrowRightIcon class="w-6 h-6" />
    </button>
  </div>
</section>

<ProjectLightbox images={images} slug={slug} />

<script>
  const thumbnailsContainer = document.getElementById("thumbnails-container");
  const thumbPrevBtn = document.getElementById("thumb-prev");
  const thumbNextBtn = document.getElementById("thumb-next");

  const scrollAmount = ((thumbnailsContainer && thumbnailsContainer.clientWidth) || 200) * 0.6;

  function updateThumbButtons() {
    if (!thumbnailsContainer || !thumbPrevBtn || !thumbNextBtn) return;
    const { scrollLeft, scrollWidth, clientWidth } = thumbnailsContainer;
    thumbPrevBtn.classList.toggle("hidden", scrollLeft <= 10);
    thumbNextBtn.classList.toggle(
      "hidden",
      scrollLeft + clientWidth >= scrollWidth - 10
    );
  }

  thumbnailsContainer?.addEventListener("scroll", updateThumbButtons);
  updateThumbButtons();

  thumbPrevBtn?.addEventListener("click", () => {
    thumbnailsContainer?.scrollBy({ left: -scrollAmount, behavior: "smooth" });
  });

  thumbNextBtn?.addEventListener("click", () => {
    thumbnailsContainer?.scrollBy({ left: scrollAmount, behavior: "smooth" });
  });
</script>

<style>
  #thumbnails-container {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  #thumbnails-container::-webkit-scrollbar {
    display: none;
  }
</style>
