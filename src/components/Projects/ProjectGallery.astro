---
import { Image } from "astro:assets";
import {
  resolveProjectImages,
  type GalleryItem,
} from "@/src/utils/imageLoader";
import ArrowLeftIcon from "@/src/icons/arrow-left.svg";
import ArrowRightIcon from "@/src/icons/arrow-right.svg";
import "photoswipe/style.css";

interface Props {
  images: GalleryItem[];
  slug: string;
}

const { images, slug } = Astro.props;

const validImages = await resolveProjectImages(slug, images);
---

<section class="mb-12" transition:animate="slide">
  <div class="flex place-items-center gap-4 mb-6">
    <div class="w-12 h-0.5 bg-linear-to-r from-indigo-500 to-transparent"></div>
    <h2 class="text-2xl font-bold">Galería</h2>
  </div>

  <div class="relative group">
    <button
      id="thumb-prev"
      class="thumb-nav absolute left-2 top-1/2 -translate-y-1/2 z-10 bg-black/50 hover:bg-black/70 text-white p-3 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-300 hidden md:flex items-center justify-center cursor-pointer"
      aria-label="Imagen anterior"
    >
      <ArrowLeftIcon class="w-6 h-6" />
    </button>

    <div
      id="my-gallery"
      class="pswp-gallery flex gap-4 overflow-x-auto snap-x snap-mandatory pb-4 p-0.75 [ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
    >
      {
        validImages.map((item) => (
          <a
            href={item.metadata.src}
            data-pswp-width={item.metadata.width}
            data-pswp-height={item.metadata.height}
            data-pswp-caption={item.description}
            target="_blank"
            class="gallery-trigger group relative shrink-0 w-[calc(50%-8px)] md:w-[calc(33.33%-10.66px)] aspect-video bg-zinc-900 cursor-pointer snap-start transition-all duration-500 block overflow-hidden rounded-xl border border-white/5 shadow-lg hover:border-indigo-500/50 hover:shadow-indigo-500/10"
            aria-label="Ampliar imagen"
          >
            <Image
              src={item.metadata}
              alt={item.description}
              class="w-full h-full object-cover object-top transition-transform duration-700 group-hover:scale-110"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-linear-to-t from-black/90 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-3 md:p-4">
              <p class="text-white text-[10px] md:text-xs font-medium transform translate-y-4 group-hover:translate-y-0 transition-transform duration-500 line-clamp-2">
                {item.description}
              </p>
            </div>
          </a>
        ))
      }
    </div>

    <button
      id="thumb-next"
      class="thumb-nav absolute right-2 top-1/2 -translate-y-1/2 z-10 bg-black/50 hover:bg-black/70 text-white p-3 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-300 hidden md:flex items-center justify-center cursor-pointer"
      aria-label="Imagen siguiente"
    >
      <ArrowRightIcon class="w-6 h-6" />
    </button>
  </div>
</section>

<script>
  import PhotoSwipeLightbox from "photoswipe/lightbox";

  function initGallery() {
    const container = document.getElementById("my-gallery");
    if (!container) return;

    const lightbox = new PhotoSwipeLightbox({
      gallery: "#my-gallery",
      children: "a",
      pswpModule: () => import("photoswipe"),
      padding: { top: 20, bottom: 20, left: 20, right: 20 },
      wheelToZoom: true,
    });

    setupPhotoSwipeCaption(lightbox);
    lightbox.init();

    setupThumbNavigation(container as HTMLElement);
  }

  function setupPhotoSwipeCaption(lightbox: PhotoSwipeLightbox) {
    lightbox.on("uiRegister", () => {
      const pswp = lightbox.pswp;
      if (!pswp?.ui) return;

      pswp.ui.registerElement({
        name: "custom-caption",
        order: 9,
        isButton: false,
        appendTo: "root",
        onInit: (el, pswpInstance) => {
          el.classList.add(
            "bg-black/60",
            "backdrop-blur-md",
            "border-t",
            "border-white/10",
            "text-white",
            "text-sm",
            "leading-relaxed",
            "p-4",
            "absolute",
            "left-0",
            "bottom-0",
            "w-full",
            "text-center",
            "z-[100]",
            "pointer-events-none",
            "shadow-[0_-10px_25px_-5px_rgba(0,0,0,0.5)]",
            "md:left-1/2",
            "md:bottom-6",
            "md:w-auto",
            "md:max-w-[80%]",
            "md:-translate-x-1/2",
            "md:rounded-xl",
            "md:border",
            "md:px-5",
            "md:py-2.5",
            "md:shadow-[0_10px_25px_-5px_rgba(0,0,0,0.3)]",
          );

          pswpInstance.on("change", () => {
            const currSlide = pswpInstance.currSlide;
            const currSlideElement = currSlide?.data?.element;
            el.innerHTML =
              currSlideElement?.getAttribute("data-pswp-caption") || "";
          });
        },
      });
    });
  }

  function setupThumbNavigation(container: HTMLElement) {
    const prevBtn = document.getElementById("thumb-prev");
    const nextBtn = document.getElementById("thumb-next");
    if (!prevBtn || !nextBtn) return;

    const getScrollAmount = () => container.clientWidth * 0.6;

    const updateButtonsVisibility = () => {
      const { scrollLeft, scrollWidth, clientWidth } = container;
      prevBtn.classList.toggle("hidden", scrollLeft <= 10);
      nextBtn.classList.toggle(
        "hidden",
        scrollLeft + clientWidth >= scrollWidth - 10,
      );
    };

    container.addEventListener("scroll", updateButtonsVisibility);

    prevBtn.addEventListener("click", () => {
      container.scrollBy({ left: -getScrollAmount(), behavior: "smooth" });
    });

    nextBtn.addEventListener("click", () => {
      container.scrollBy({ left: getScrollAmount(), behavior: "smooth" });
    });

    updateButtonsVisibility();
  }

  document.addEventListener("astro:page-load", initGallery);
</script>
