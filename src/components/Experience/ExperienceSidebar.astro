---
import { Icon } from "astro-icon/components";

interface Props {
  technologies?: string[];
  keyProjects?: { name: string; description: string; slug?: string }[];
}

const { technologies, keyProjects } = Astro.props;
---

<div class="space-y-8">
  <!-- Technologies -->
  {
    technologies && (
      <div
        class="p-8 bg-white/3 border border-white/5 rounded-3xl backdrop-blur-sm"
        data-reveal
        data-reveal-type="fade-left"
        data-reveal-delay="0.2"
      >
        <div class="flex items-center gap-3 mb-6">
          <Icon name="zap" class="w-5 h-5 text-indigo-400" />
          <h3 class="text-sm font-bold text-white uppercase tracking-wider">
            Tecnologías
          </h3>
        </div>
        <div class="flex flex-wrap gap-2">
          {technologies.map((tech) => (
            <span class="px-3 py-1.5 bg-white/5 border border-white/10 rounded-lg text-xs font-medium text-gray-400 hover:text-white hover:border-white/20 transition cursor-default">
              {tech}
            </span>
          ))}
        </div>
      </div>
    )
  }

  <!-- Key Projects -->
  {
    keyProjects && (
      <div
        class="p-8 bg-white/3 border border-white/5 rounded-3xl backdrop-blur-sm"
        data-reveal
        data-reveal-type="fade-left"
        data-reveal-delay="0.3"
      >
        <div class="flex items-center gap-3 mb-6">
          <Icon name="folder" class="w-5 h-5 text-indigo-400" />
          <h3 class="text-sm font-bold text-white uppercase tracking-wider">
            Proyectos Clave
          </h3>
        </div>
        <div class="space-y-4">
          {keyProjects.map((project) =>
            project.slug ? (
              <a
                href={`/projects/${project.slug}`}
                class="block p-4 bg-white/5 border border-white/5 rounded-2xl hover:border-indigo-500/30 transition group"
              >
                <h4 class="text-sm font-bold text-white mb-1 group-hover:text-indigo-300 transition">
                  {project.name}
                </h4>
                <p class="text-xs text-gray-500 line-clamp-2">
                  {project.description}
                </p>
              </a>
            ) : (
              <div class="p-4 bg-white/5 border border-white/5 rounded-2xl">
                <h4 class="text-sm font-bold text-white mb-1">
                  {project.name}
                </h4>
                <p class="text-xs text-gray-500 line-clamp-2">
                  {project.description}
                </p>
              </div>
            ),
          )}
        </div>
      </div>
    )
  }

  <!-- CTA Card -->
  <div
    class="p-8 bg-indigo-600 rounded-3xl relative overflow-hidden group"
    data-reveal
    data-reveal-type="scale-in"
    data-reveal-delay="0.4"
  >
    <div
      class="absolute top-0 right-0 w-32 h-32 bg-white/10 blur-3xl rounded-full -translate-y-1/2 translate-x-1/2"
    >
    </div>
    <div class="relative z-10">
      <h3 class="text-xl font-bold text-white mb-4">
        ¿Te interesa que trabajemos juntos?
      </h3>
      <p class="text-indigo-100 text-sm mb-8 leading-relaxed">
        Actualmente estoy abierto a proyectos colaborativos y
        oportunidades de ingeniería senior.
      </p>
      <a
        href="/#contact"
        class="flex items-center justify-center gap-2 w-full py-4 bg-white text-indigo-600 rounded-2xl font-bold hover:bg-indigo-50 transition shadow-xl"
      >
        <Icon name="mail" class="w-5 h-5" />
        Contactar
      </a>
    </div>
  </div>
</div>
