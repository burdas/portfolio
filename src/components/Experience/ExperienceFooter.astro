---
import { Icon } from "astro-icon/components";

interface Props {
  prevJob?: {
    slug: string;
    data: {
      role: string;
      company: string;
    };
  } | null;
  nextJob?: {
    slug: string;
    data: {
      role: string;
      company: string;
    };
  } | null;
}

const { prevJob, nextJob } = Astro.props;
---

<footer class="mt-0 md:mt-32 pt-16" data-reveal data-reveal-type="fade-up">
  <div
    class="grid grid-cols-2 md:grid-cols-3 items-start gap-y-12 gap-x-4 md:gap-12"
  >
    <!-- Prev -->
    <div class="order-1">
      {
        prevJob ? (
          <a href={`/experience/${prevJob.slug}`} class="group block">
            <span class="text-[10px] font-bold tracking-[0.2em] uppercase text-gray-500 block mb-2">
              <span class="hidden md:inline">Experiencia</span> Anterior
            </span>
            <div class="flex items-center gap-3">
              <Icon
                name="arrow-left"
                class="w-5 h-5 text-gray-500 group-hover:text-white transition group-hover:-translate-x-1 shrink-0"
              />
              <span class="text-sm md:text-lg font-bold text-gray-400 group-hover:text-white transition">
                {prevJob.data.role}
              </span>
            </div>
          </a>
        ) : (
          <div class="opacity-0 pointer-events-none">Empty</div>
        )
      }
    </div>

    <!-- Socials -->
    <div
      class="order-3 md:order-2 col-span-2 md:col-span-1 flex items-center justify-center gap-8 pt-8 md:pt-0"
    >
      <a
        href="mailto:marcos@burdaspar.com"
        class="text-gray-500 hover:text-white transition"
      >
        <Icon name="mail" class="w-6 h-6" />
      </a>
      <a
        href="https://linkedin.com/in/burdaspar"
        target="_blank"
        class="text-gray-500 hover:text-white transition"
      >
        <Icon name="linkedin" class="w-6 h-6" />
      </a>
      <a
        href="https://github.com/burdaspar"
        target="_blank"
        class="text-gray-500 hover:text-white transition"
      >
        <Icon name="github" class="w-6 h-6" />
      </a>
    </div>

    <!-- Next -->
    <div class="order-2 md:order-3 text-right">
      {
        nextJob ? (
          <a href={`/experience/${nextJob.slug}`} class="group block">
            <span class="text-[10px] font-bold tracking-[0.2em] uppercase text-gray-500 block mb-2">
              Siguiente <span class="hidden md:inline">Experiencia</span>
            </span>
            <div class="flex items-center justify-end gap-3">
              <span class="text-sm md:text-lg font-bold text-gray-400 group-hover:text-white transition">
                {nextJob.data.role}
              </span>
              <Icon
                name="arrow-right"
                class="w-5 h-5 text-gray-500 group-hover:text-white transition group-hover:translate-x-1 shrink-0"
              />
            </div>
          </a>
        ) : (
          <div>
            <span class="text-[10px] font-bold tracking-[0.2em] uppercase text-gray-500 block mb-2">
              Siguiente <span class="hidden md:inline">Experiencia</span>
            </span>
            <span class="text-sm md:text-lg font-bold text-gray-600">
              Próximamente...
            </span>
          </div>
        )
      }
    </div>
  </div>
</footer>
