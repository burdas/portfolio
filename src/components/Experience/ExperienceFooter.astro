---
import { Icon } from "astro-icon/components";

interface Props {
  prevJob?: {
    slug: string;
    data: {
      role: string;
      company: string;
    };
  } | null;
  nextJob?: {
    slug: string;
    data: {
      role: string;
      company: string;
    };
  } | null;
}

const { prevJob, nextJob } = Astro.props;
---

<footer
  class="mt-32 pt-16 border-t border-white/5"
  data-reveal
  data-reveal-type="fade-up"
>
  <div class="flex flex-col md:flex-row justify-between items-center gap-12">
    <!-- Prev -->
    <div class="flex-1 w-full md:w-auto">
      {
        prevJob ? (
          <a href={`/experience/${prevJob.slug}`} class="group block">
            <span class="text-[10px] font-bold tracking-[0.2em] uppercase text-gray-500 block mb-2">
              Experiencia Anterior
            </span>
            <div class="flex items-center gap-3">
              <Icon
                name="arrow-left"
                class="w-5 h-5 text-gray-500 group-hover:text-white transition group-hover:-translate-x-1"
              />
              <span class="text-lg font-bold text-gray-400 group-hover:text-white transition">
                {prevJob.data.role} • {prevJob.data.company}
              </span>
            </div>
          </a>
        ) : (
          <div class="opacity-0 pointer-events-none">Empty</div>
        )
      }
    </div>

    <!-- Socials -->
    <div class="flex items-center gap-8">
      <a
        href="mailto:marcos@burdaspar.com"
        class="text-gray-500 hover:text-white transition"
      >
        <Icon name="mail" class="w-6 h-6" />
      </a>
      <a
        href="https://linkedin.com/in/burdaspar"
        target="_blank"
        class="text-gray-500 hover:text-white transition"
      >
        <Icon name="linkedin" class="w-6 h-6" />
      </a>
      <a
        href="https://github.com/burdaspar"
        target="_blank"
        class="text-gray-500 hover:text-white transition"
      >
        <Icon name="github" class="w-6 h-6" />
      </a>
    </div>

    <!-- Next -->
    <div class="flex-1 w-full md:w-auto text-right">
      {
        nextJob ? (
          <a href={`/experience/${nextJob.slug}`} class="group block">
            <span class="text-[10px] font-bold tracking-[0.2em] uppercase text-gray-500 block mb-2">
              Siguiente Experiencia Laboral
            </span>
            <div class="flex items-center justify-end gap-3">
              <span class="text-lg font-bold text-gray-400 group-hover:text-white transition">
                {nextJob.data.role} • {nextJob.data.company}
              </span>
              <Icon
                name="arrow-right"
                class="w-5 h-5 text-gray-500 group-hover:text-white transition group-hover:translate-x-1"
              />
            </div>
          </a>
        ) : (
          <div>
            <span class="text-[10px] font-bold tracking-[0.2em] uppercase text-gray-500 block mb-2">
              Siguiente Experiencia Laboral
            </span>
            <span class="text-lg font-bold text-gray-600">Próximamente...</span>
          </div>
        )
      }
    </div>
  </div>
</footer>
