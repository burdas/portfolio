---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import logo from "../assets/logo.avif";
---

<div
  id="chatbot-container"
  class="fixed bottom-6 right-6 z-50 font-['JetBrains_Mono']"
>
  <button
    id="chat-toggle"
    class="chat-button-initial h-20 rounded-full backdrop-blur-xl border border-white/10 bg-white/5 hover:border-transparent text-white flex items-center justify-end shadow-2xl hover:scale-105 transition-all duration-500 cursor-pointer overflow-hidden group relative"
    aria-label="Toggle chat"
  >
    <div
      id="chat-marquee"
      class="whitespace-nowrap overflow-hidden w-0 opacity-0 transition-all duration-700 ease-in-out"
    >
      <div class="pl-8 text-sm font-medium text-white/80">
        <span class="inline-block animate-marquee paused">
          Charla con la IA sobre mi
        </span>
        <span class="inline-block animate-marquee paused">
          Charla con la IA sobre mi
        </span>
      </div>
    </div>

    <div class="shrink-0 w-20 h-20 flex items-center justify-center p-3 z-10">
      <Image src={logo} alt="Logo" class="w-full h-full object-contain" />
    </div>
  </button>

  <div
    id="chat-window"
    class="fixed inset-0 sm:absolute sm:inset-auto sm:bottom-24 sm:right-0 w-full h-dvh sm:w-125 sm:h-[calc(100dvh-150px)] sm:max-h-200 bg-black/60 backdrop-blur-3xl sm:rounded-4xl shadow-[0_0_50px_-12px_rgba(0,0,0,0.5)] flex flex-col opacity-0 translate-y-8 transition-all duration-500 ease-out overflow-hidden border-0 sm:border sm:border-white/10 hidden"
  >
    <div class="p-8 pb-0 flex justify-end items-center sm:hidden shrink-0">
      <button
        id="close-chat"
        class="text-white/30 hover:text-white cursor-pointer p-2 hover:bg-white/5 rounded-full transition-all"
      >
        <Icon name="chat-close" class="w-7 h-7" />
      </button>
    </div>
    <div
      id="chat-messages"
      class="flex-1 overflow-y-auto px-8 pt-0 sm:pt-8 pb-4 space-y-6 scroll-smooth"
    >
      <!-- Messages will be injected here -->
    </div>
    <div class="p-8 pb-10 shrink-0">
      <form id="chat-form" class="relative">
        <input
          type="text"
          id="chat-input"
          placeholder="Pregunta lo que quieras"
          class="w-full bg-white/3 rounded-xl px-6 py-5 pr-16 text-sm focus:outline-none focus:border-white/20 focus:bg-white/5 transition-all placeholder:text-white/20"
          autocomplete="off"
        />
        <button
          type="submit"
          id="chat-submit"
          class="absolute right-3 top-1/2 -translate-y-1/2 bg-indigo-600 text-white w-10 h-10 rounded-lg flex items-center justify-center hover:bg-indigo-500 hover:scale-105 disabled:opacity-20 disabled:grayscale transition-all cursor-pointer shadow-lg shadow-indigo-600/20"
        >
          <Icon name="chat-send" class="w-5 h-5" />
        </button>
      </form>
    </div>
  </div>
</div>

<script>
  import "../scripts/chatbot/main";
</script>

<style is:global>
  .markdown-content p {
    margin-bottom: 0.75rem;
  }
  .markdown-content p:last-child {
    margin-bottom: 0;
  }
  .markdown-content strong {
    color: white;
    font-weight: 600;
  }
  .markdown-content ul,
  .markdown-content ol {
    list-style-type: disc;
    margin-left: 1.25rem;
    margin-bottom: 0.75rem;
  }
  .markdown-content li {
    margin-bottom: 0.25rem;
  }
  .markdown-content a {
    color: #818cf8;
    text-decoration: underline;
    transition: color 0.2s;
  }
  .markdown-content a:hover {
    color: #a5b4fc;
  }

  /* Table Styles */
  .markdown-content table {
    display: block;
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border-collapse: collapse;
    margin-bottom: 1rem;
    font-size: 0.8rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.02);
    border-radius: 0.5rem;
  }

  /* Custom scrollbar for tables */
  .markdown-content table::-webkit-scrollbar {
    height: 4px;
  }
  .markdown-content table::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.05);
  }
  .markdown-content table::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.2);
    border-radius: 10px;
  }

  .markdown-content th,
  .markdown-content td {
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 0.5rem 0.75rem;
    text-align: left;
    min-width: 100px;
  }
  .markdown-content th {
    background: rgba(255, 255, 255, 0.05);
    color: white;
    font-weight: 600;
  }
  .markdown-content tr:nth-child(even) {
    background: rgba(255, 255, 255, 0.01);
  }

  /* Code blocks */
  .markdown-content code {
    background: rgba(255, 255, 255, 0.1);
    padding: 0.1rem 0.3rem;
    border-radius: 0.25rem;
    font-family: inherit;
    font-size: 0.85em;
  }
  .markdown-content pre code {
    display: block;
    padding: 1rem;
    overflow-x: auto;
    background: rgba(0, 0, 0, 0.3);
    margin-bottom: 1rem;
  }
</style>

<style>
  .chat-button-initial {
    width: 80px;
  }

  #chat-window.is-wide {
    @media (min-width: 640px) {
      width: 800px;
    }
  }

  #chat-messages {
    display: flex;
    flex-direction: column;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  #chat-messages::-webkit-scrollbar {
    display: none;
  }

  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-100%);
    }
  }

  .animate-marquee {
    animation: marquee 4s linear infinite;
    padding-right: 50px;
  }

  .animate-marquee.paused {
    animation-play-state: paused;
  }

  #chat-input::placeholder {
    font-size: 0.75rem; /* text-xs */
    transition: opacity 0.3s;
  }

  @keyframes shimmer {
    0% {
      background-position: 200% 50%;
    }
    100% {
      background-position: -200% 50%;
    }
  }

  #chat-toggle:hover {
    border-color: transparent;
  }

  #chat-toggle::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 9999px; /* rounded-full */
    padding: 2px; /* border thickness */
    background: linear-gradient(90deg, #c084fc, #818cf8, #c084fc);
    background-size: 200% 100%;
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 500ms ease-in-out;
    pointer-events: none;
  }

  #chat-toggle:hover::after {
    opacity: 1;
    animation: shimmer 3s linear infinite;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const chatWindow = document.getElementById("chat-window");

    if (window.visualViewport && chatWindow) {
      const isMobile = () => window.innerWidth < 640; // Tailwind's 'sm' breakpoint

      const applyViewportStyles = () => {
        if (!isMobile()) {
          // Reset styles on desktop to use CSS-defined values
          chatWindow.style.height = "";
          chatWindow.style.transform = "";
          return;
        }

        const { offsetTop, height } = window.visualViewport;
        chatWindow.style.height = `${height}px`;
        chatWindow.style.transform = `translateY(${offsetTop}px)`;
      };

      window.visualViewport.addEventListener("resize", applyViewportStyles);
      window.visualViewport.addEventListener("scroll", applyViewportStyles);
      applyViewportStyles(); // Initial call
    }
  });
</script>
