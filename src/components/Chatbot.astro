---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import logo from "../assets/logo.avif";
---

<div
  id="chatbot-container"
  class="fixed bottom-6 right-6 z-50 font-['JetBrains_Mono']"
>
  <button
    id="chat-toggle"
    class="chat-button-initial h-20 rounded-full bg-white/5 backdrop-blur-2xl border border-white/10 text-white flex items-center justify-end shadow-2xl hover:scale-105 hover:border-white/30 transition-all duration-500 cursor-pointer overflow-hidden group"
    aria-label="Toggle chat"
  >
    <div
      id="chat-marquee"
      class="whitespace-nowrap overflow-hidden w-0 opacity-0 transition-all duration-700 ease-in-out"
    >
      <div class="pl-8 text-sm font-medium text-white/80">
        <span class="inline-block animate-marquee paused">
          Charla con la IA sobre mi
        </span>
        <span class="inline-block animate-marquee paused">
          Charla con la IA sobre mi
        </span>
      </div>
    </div>

    <div
      class="shrink-0 w-20 h-20 flex items-center justify-center p-3 z-10 bg-black/10"
    >
      <Image src={logo} alt="Logo" class="w-full h-full object-contain" />
    </div>
  </button>

  <div
    id="chat-window"
    class="fixed inset-0 sm:absolute sm:inset-auto sm:bottom-24 sm:right-0 w-full h-full sm:w-125 sm:h-[calc(100dvh-150px)] sm:max-h-[800px] bg-black/60 backdrop-blur-3xl sm:rounded-[2rem] shadow-[0_0_50px_-12px_rgba(0,0,0,0.5)] flex flex-col opacity-0 translate-y-8 transition-all duration-500 ease-out overflow-hidden border-0 sm:border sm:border-white/10 hidden"
  >
    <div class="p-8 pb-0 flex justify-end items-center">
      <button
        id="close-chat"
        class="text-white/30 hover:text-white cursor-pointer p-2 hover:bg-white/5 rounded-full transition-all"
      >
        <Icon name="chat-close" class="w-7 h-7" />
      </button>
    </div>
    <div
      id="chat-messages"
      class="flex-1 overflow-y-auto px-8 pb-4 space-y-6 scroll-smooth"
    >
      <div class="flex flex-col gap-3">
        <div
          class="rounded-2xl rounded-tl-none py-2 text-sm leading-relaxed max-w-[90%] text-white/80"
        >
          Hola, soy la IA de Marcos. He analizado sus proyectos y experiencia
          profesional, ¿en qué puedo ayudarte?
        </div>
      </div>
    </div>
    <div class="p-8 pb-10">
      <form id="chat-form" class="relative">
        <input
          type="text"
          id="chat-input"
          placeholder="Pregunta lo que quieras"
          class="w-full bg-white/3 rounded-xl px-6 py-5 pr-16 text-sm focus:outline-none focus:border-white/20 focus:bg-white/5 transition-all placeholder:text-white/20"
          autocomplete="off"
        />
        <button
          type="submit"
          id="chat-submit"
          class="absolute right-3 top-1/2 -translate-y-1/2 bg-indigo-600 text-white w-10 h-10 rounded-lg flex items-center justify-center hover:bg-indigo-500 hover:scale-105 disabled:opacity-20 disabled:grayscale transition-all cursor-pointer shadow-lg shadow-indigo-600/20"
        >
          <Icon name="chat-send" class="w-5 h-5" />
        </button>
      </form>
    </div>
  </div>
</div>

<script>
  import { marked } from "marked";

  interface ChatMessage {
    role: "user" | "assistant";
    content: string;
  }

  let mermaidLoaded = false;
  const loadMermaid = () => {
    if (mermaidLoaded) return Promise.resolve();
    return new Promise((resolve) => {
      const script = document.createElement("script");
      script.src = "https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js";
      script.onload = () => {
        mermaidLoaded = true;
        // @ts-ignore
        mermaid.initialize({
          startOnLoad: false,
          theme: "dark",
          securityLevel: "loose",
          fontFamily: "JetBrains Mono",
        });
        resolve(true);
      };
      document.head.appendChild(script);
    });
  };

  document.addEventListener("astro:page-load", () => {
    const chatToggle = document.getElementById("chat-toggle");
    const chatMarquee = document.getElementById("chat-marquee");
    const chatWindow = document.getElementById("chat-window");
    const closeChat = document.getElementById("close-chat");
    const chatForm = document.getElementById("chat-form") as HTMLFormElement;
    const chatInput = document.getElementById("chat-input") as HTMLInputElement;
    const chatMessages = document.getElementById("chat-messages");
    const chatSubmit = document.getElementById("chat-submit") as HTMLButtonElement;

    if (!chatToggle || !chatForm) return;

    const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            setTimeout(() => {
              chatToggle.style.width = "280px";
              if (chatMarquee) {
                chatMarquee.style.width = "200px";
                chatMarquee.style.opacity = "1";
                setTimeout(() => {
                  const marquees = chatMarquee.querySelectorAll(".animate-marquee");
                  marquees.forEach((m) => m.classList.remove("paused"));
                }, 700);
              }
              setTimeout(() => {
                chatToggle.style.width = "80px";
                if (chatMarquee) {
                  chatMarquee.style.width = "0px";
                  chatMarquee.style.opacity = "0";
                }
              }, 4000);
            }, 1000);
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.5 });

    observer.observe(chatToggle);

    let isOpen = false;
    let history: ChatMessage[] = [];
    let isLoading = false;

    function toggleChat() {
      isOpen = !isOpen;
      if (isOpen) {
        chatWindow?.classList.remove("hidden");
        document.body.classList.add("overflow-hidden", "sm:overflow-auto");
        setTimeout(() => {
          chatWindow?.classList.remove("opacity-0", "translate-y-8");
          chatWindow?.classList.add("opacity-100", "translate-y-0");
        }, 10);
        chatInput?.focus();
      } else {
        chatWindow?.classList.add("opacity-0", "translate-y-8");
        chatWindow?.classList.remove("opacity-100", "translate-y-0");
        document.body.classList.remove("overflow-hidden", "sm:overflow-auto");
        setTimeout(() => {
          chatWindow?.classList.add("hidden");
          chatWindow?.classList.remove("is-wide");
        }, 500);
      }
    }

    chatToggle.addEventListener("click", toggleChat);
    closeChat?.addEventListener("click", toggleChat);

    async function addMessage(role: "user" | "assistant", content: string) {
      if (!chatMessages) return;
      
      const messageWrapper = document.createElement("div");
      messageWrapper.className = "flex flex-col gap-3";
      if (content === "...") {
        messageWrapper.setAttribute("data-is-loading", "true");
      }

      const messageDiv = document.createElement("div");

      if (role === "user") {
        messageDiv.className =
          "bg-white/3 border border-white/10 rounded-2xl rounded-tr-none p-5 text-sm leading-relaxed max-w-[90%] self-end ml-auto text-white/90 shadow-xl";
        messageDiv.textContent = content;
      } else {
        messageDiv.className =
          "rounded-2xl rounded-tl-none py-2 text-sm leading-relaxed max-w-[90%] text-white/80 markdown-content";
        if (content === "...") {
          messageDiv.innerHTML = `
            <div class="chat-skeleton flex flex-col gap-3 w-64 animate-pulse pt-1">
              <div class="h-3 bg-white/10 rounded w-full"></div>
              <div class="h-3 bg-white/10 rounded w-5/6"></div>
              <div class="h-3 bg-white/10 rounded w-4/6"></div>
            </div>
          `;
        } else {
          const html = await marked.parse(content);
          messageDiv.innerHTML = html;
        }
      }

      messageWrapper.appendChild(messageDiv);
      chatMessages.appendChild(messageWrapper);

      // Procesamiento post-inserción
      if (role === "assistant" && content !== "...") {
        const hasMermaid = messageDiv.querySelector(".language-mermaid");
        const hasTable = messageDiv.querySelector("table");

        if (hasTable || hasMermaid || content.length > 600) {
          chatWindow?.classList.add("is-wide");
        }

        if (hasMermaid) {
          await loadMermaid();
          const mermaidBlocks = messageDiv.querySelectorAll(".language-mermaid");
          
          for (const [index, block] of Array.from(mermaidBlocks).entries()) {
            const pre = block.parentElement;
            if (pre) {
              const container = document.createElement("div");
              container.className = "mermaid-outer my-6 bg-white/5 p-4 rounded-xl border border-white/5 flex flex-col items-center group cursor-zoom-in";
              
              const scrollContainer = document.createElement("div");
              scrollContainer.className = "w-full overflow-x-auto scrollbar-hide flex justify-center";

              const mermaidDiv = document.createElement("div");
              const uniqueId = `mermaid-${Date.now()}-${index}`;
              mermaidDiv.id = uniqueId;
              mermaidDiv.className = "mermaid min-w-full opacity-0 transition-opacity duration-500";
              
              const zoomHint = document.createElement("div");
              zoomHint.className = "text-[10px] text-white/20 mt-2 opacity-0 group-hover:opacity-100 transition-opacity";
              zoomHint.textContent = "Click para expandir";

              scrollContainer.appendChild(mermaidDiv);
              container.appendChild(scrollContainer);
              container.appendChild(zoomHint);
              pre.replaceWith(container);

              // Evento para expandir
              container.addEventListener("click", () => {
                const svg = mermaidDiv.querySelector("svg");
                if (!svg) return;
                
                const modal = document.createElement("div");
                modal.className = "fixed inset-0 z-[100] bg-black/90 backdrop-blur-xl flex items-center justify-center p-4 sm:p-10 cursor-zoom-out";
                
                const closeBtn = document.createElement("button");
                closeBtn.innerHTML = "✕";
                closeBtn.className = "absolute top-6 right-6 text-white text-2xl hover:scale-110 transition-transform";
                
                const svgClone = svg.cloneNode(true) as SVGElement;
                svgClone.style.width = "auto";
                svgClone.style.height = "auto";
                svgClone.style.maxWidth = "90vw";
                svgClone.style.maxHeight = "80vh";
                svgClone.classList.add("drop-shadow-2xl");

                modal.appendChild(closeBtn);
                modal.appendChild(svgClone);
                document.body.appendChild(modal);
                
                modal.addEventListener("click", () => modal.remove());
              });
              
              // Limpieza profunda del código Mermaid
              let code = block.textContent || "";
              
              // 1. Limpieza de artefactos del LLM y espacios innecesarios
              code = code
                .trim()
                .replace(/^```mermaid\s+/i, "") 
                .replace(/```$/i, "")           
                .replace(/^(mermaid\s+)+/i, "") 
                .trim();

              // 2. Asegurar que empiece por un comando válido de Mermaid si el LLM se olvidó
              // o si incluyó texto explicativo antes
              const validStarts = ['graph', 'sequenceDiagram', 'classDiagram', 'stateDiagram', 'erDiagram', 'journey', 'gantt', 'pie', 'quadrantChart', 'mindmap', 'timeline', 'gitGraph', 'C4Context'];
              const firstLine = code.split('\n')[0].trim();
              const hasValidStart = validStarts.some(start => firstLine.toLowerCase().startsWith(start.toLowerCase()));
              
              if (!hasValidStart && !firstLine.includes('{')) {
                // Si no detectamos un inicio válido, intentamos buscarlo más adelante
                // por si el LLM puso texto antes del diagrama
                const lines = code.split('\n');
                const startIndex = lines.findIndex(line => 
                  validStarts.some(start => line.trim().toLowerCase().startsWith(start.toLowerCase()))
                );
                
                if (startIndex !== -1) {
                  code = lines.slice(startIndex).join('\n').trim();
                } else {
                  // Fallback: Si no hay inicio claro, asumimos graph TD
                  code = 'graph TD\n' + code;
                }
              }
              
              // 3. Validaciones y correcciones automáticas
              if (!code || code.length < 5) {
                container.remove();
                continue;
              }

              // Corrección de errores comunes del LLM
              code = code
                .replace(/\|>/g, "|") // Corregir |>
                // 1. Limpiar comillas dobles anidadas dentro de etiquetas ya entrecomilladas
                .replace(/\|"(.*?)"\|/g, (match, p1) => `|"${p1.replace(/"/g, "'")}"|`)
                .replace(/(\[|\()"(.*?)"(\]|\))/g, (match, start, p1, end) => `${start}"${p1.replace(/"/g, "'")}"${end}`)
                // 2. Envolver etiquetas de flechas |texto| que tengan caracteres especiales pero NO comillas
                .replace(/\|([^|"\n]+)\|/g, (match, p1) => {
                  if (/[()\[\]:,]/.test(p1)) return `|"${p1.trim()}"|`;
                  return match;
                })
                // 3. Envolver etiquetas de nodos [texto] o (texto) que tengan caracteres especiales pero NO comillas
                .replace(/(\[|\()([^\]\)"\n]+)(\]|\))/g, (match, start, p1, end) => {
                  if (/[()\[\]:,]/.test(p1)) return `${start}"${p1.trim()}"${end}`;
                  return match;
                });
              
              mermaidDiv.textContent = code;
              container.appendChild(mermaidDiv);
              pre.replaceWith(container);

              try {
                // @ts-ignore
                await mermaid.run({
                  nodes: [mermaidDiv]
                });
                mermaidDiv.classList.remove("opacity-0");
                mermaidDiv.classList.add("opacity-100");
              } catch (err) {
                console.error("Mermaid render error:", err, "Code:", code);
                // Si falla, intentamos una última vez limpiando caracteres invisibles raros
                try {
                  const cleanCode = code.replace(/[^\x20-\x7E\n]/g, "");
                  mermaidDiv.textContent = cleanCode;
                  // @ts-ignore
                  await mermaid.run({ nodes: [mermaidDiv] });
                  mermaidDiv.classList.remove("opacity-0");
                  mermaidDiv.classList.add("opacity-100");
                } catch (err2) {
                  container.innerHTML = `<div class="text-[10px] text-white/20 italic p-2 text-center">Diagrama técnico (error de sintaxis)</div>`;
                }
              }
            }
          }
        }
      }

      chatMessages.scrollTop = chatMessages.scrollHeight;

      if (role !== "assistant" || content !== "...") {
        history.push({ role, content });
      }
      return messageDiv;
    }

    chatForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      const message = chatInput?.value.trim();
      if (!message || isLoading) return;

      chatInput.value = "";
      await addMessage("user", message);
      isLoading = true;
      chatSubmit.disabled = true;

      await addMessage("assistant", "...");
      
      try {
        const response = await fetch("/api/chat", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ message, history }),
        });

        // ELIMINACIÓN SEGURA DEL SKELETON ANTES DE PROCESAR
        const skeletons = chatMessages?.querySelectorAll('[data-is-loading="true"]');
        skeletons?.forEach(s => s.remove());

        if (response.status === 429) {
          await addMessage(
            "assistant",
            "Se ha alcanzado el límite diario de consultas. Vuelve mañana 🙏",
          );
        } else if (!response.ok) {
          throw new Error("Server error");
        } else {
          const data = await response.json();
          await addMessage("assistant", data.content);
        }
      } catch (error) {
        console.error("Chat error:", error);
        const skeletons = chatMessages?.querySelectorAll('[data-is-loading="true"]');
        skeletons?.forEach(s => s.remove());
        await addMessage("assistant", "Ha ocurrido un error. Inténtalo de nuevo.");
      } finally {
        isLoading = false;
        chatSubmit.disabled = false;
        chatMessages?.scrollTo({ top: chatMessages.scrollHeight, behavior: 'smooth' });
      }
    });
  });
</script>

<style is:global>
  .markdown-content p {
    margin-bottom: 0.75rem;
  }
  .markdown-content p:last-child {
    margin-bottom: 0;
  }
  .markdown-content strong {
    color: white;
    font-weight: 600;
  }
  .markdown-content ul, .markdown-content ol {
    list-style-type: disc;
    margin-left: 1.25rem;
    margin-bottom: 0.75rem;
  }
  .markdown-content li {
    margin-bottom: 0.25rem;
  }
  .markdown-content a {
    color: #818cf8;
    text-decoration: underline;
    transition: color 0.2s;
  }
  .markdown-content a:hover {
    color: #a5b4fc;
  }
  
  /* Table Styles */
  .markdown-content table {
    display: block;
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border-collapse: collapse;
    margin-bottom: 1rem;
    font-size: 0.8rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.02);
    border-radius: 0.5rem;
  }
  
  /* Custom scrollbar for tables */
  .markdown-content table::-webkit-scrollbar {
    height: 4px;
  }
  .markdown-content table::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.05);
  }
  .markdown-content table::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.2);
    border-radius: 10px;
  }

  .markdown-content th, .markdown-content td {
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 0.5rem 0.75rem;
    text-align: left;
    min-width: 100px;
  }
  .markdown-content th {
    background: rgba(255, 255, 255, 0.05);
    color: white;
    font-weight: 600;
  }
  .markdown-content tr:nth-child(even) {
    background: rgba(255, 255, 255, 0.01);
  }

  /* Code blocks */
  .markdown-content code {
    background: rgba(255, 255, 255, 0.1);
    padding: 0.1rem 0.3rem;
    border-radius: 0.25rem;
    font-family: inherit;
    font-size: 0.85em;
  }
  .markdown-content pre code {
    display: block;
    padding: 1rem;
    overflow-x: auto;
    background: rgba(0, 0, 0, 0.3);
    margin-bottom: 1rem;
  }
</style>

<style>
  .chat-button-initial {
    width: 80px;
  }

  #chat-window.is-wide {
    @media (min-width: 640px) {
      width: 800px;
    }
  }

  #chat-messages {
    display: flex;
    flex-direction: column;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  #chat-messages::-webkit-scrollbar {
    display: none;
  }

  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-100%);
    }
  }

  .animate-marquee {
    animation: marquee 4s linear infinite;
    padding-right: 50px;
  }

  .animate-marquee.paused {
    animation-play-state: paused;
  }
</style>
