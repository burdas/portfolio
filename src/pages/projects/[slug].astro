---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import ProjectBreadcrumb from "@/src/components/Projects/ProjectBreadcrumb.astro";
import ProjectHeader from "@/src/components/Projects/ProjectHeader.astro";
import ProjectHero from "@/src/components/Projects/ProjectHero.astro";
import ProjectContent from "@/src/components/Projects/ProjectContent.astro";
import ProjectSidebar from "@/src/components/Projects/ProjectSidebar.astro";
import ProjectCTA from "@/src/components/Projects/ProjectCTA.astro";
import ProjectGallery from "@/src/components/Projects/ProjectGallery.astro";
import ProjectFooter from "@/src/components/Projects/ProjectFooter.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects
    .sort((a, b) => a.data.order - b.data.order)
    .map((project) => ({
      params: { slug: project.id.replace(/\.md$/, "") },
      props: { project },
    }));
}

const { project } = Astro.props;
const { data } = project;
const gallery = data.gallery;
const slug = project.slug;

const allProjects = await getCollection("projects");
const sortedProjects = allProjects.sort((a, b) => a.data.order - b.data.order);
const currentIndex = sortedProjects.findIndex((p) => p.id === project.id);
const prevProject = currentIndex > 0 ? sortedProjects[currentIndex - 1] : null;
const nextProject =
  currentIndex < sortedProjects.length - 1
    ? sortedProjects[currentIndex + 1]
    : null;

// Ideally we would resolve the absolute URL for the OG image here
---

<Layout 
  title={`${data.name} - Proyecto`} 
  description={data.description}
  ogImage={`/og/${Astro.params.slug}.png`}
  ogImageWidth="1200"
  ogImageHeight="630"
>
  <article class="min-h-screen pt-8 sm:pt-24 pb-16 bg-neutral-950">
    <div class="max-w-5xl mx-auto px-6">
      <ProjectBreadcrumb projectName={data.name} />

      <ProjectHeader
        name={data.name}
        description={data.description}
        url={data.url}
        repo={data.repo}
        projectId={project.id}
      />

      <ProjectHero
        slug={project.id}
        role={data.role}
        duration={data.duration}
        client={data.client}
        coreTech={data.coreTech}
      />

      <ProjectContent
        fullDescription={data.fullDescription}
        challenges={data.challenges}
        solutions={data.solutions}
      >
        <ProjectSidebar
          slot="sidebar"
          tech={data.tech}
          features={data.features}
        />
      </ProjectContent>

      <ProjectGallery images={gallery ?? []} slug={slug} />

      <ProjectCTA url={data.url} repo={data.repo} />

      <ProjectFooter prevProject={prevProject} nextProject={nextProject} />
    </div>
  </article>
</Layout>
