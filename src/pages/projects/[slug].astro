---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import ProjectImage from "../../components/Projects/ProjectImage.astro";
import { Icon } from "astro-icon/components";
import GlassCard from "@/src/components/Shared/GlassCard.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects
    .sort((a, b) => a.data.order - b.data.order)
    .map((project) => ({
      params: { slug: project.id.replace(/\.md$/, "") },
      props: { project },
    }));
}

const { project } = Astro.props;
const { data } = project;
---

<Layout title={`${data.name} - Proyecto`} description={data.description}>
  <article class="min-h-screen pt-24 pb-16 bg-neutral-950">
    <div class="max-w-5xl mx-auto px-6">
      <nav class="mb-4" transition:animate="slide">
        <ol class="flex items-center gap-2 text-sm">
          <li>
            <a
              href="/#projects"
              class="text-gray-500 hover:text-white transition"
            >
              Proyectos
            </a>
          </li>
          <li>
            <Icon name="arrow-right" class="w-4 h-4 text-gray-600" />
          </li>
          <li class="text-gray-400">{data.name}</li>
        </ol>
      </nav>
      <header class="mb-12" transition:animate="slide">
        <h1
          class="text-5xl md:text-6xl font-bold mb-4"
          transition:name={`project-title-${project.id}`}
        >
          {data.name}
        </h1>
        <p
          class="text-xl text-gray-400 mb-8 max-w-2xl"
          transition:name={`project-description-${project.id}`}
        >
          {data.description}
        </p>
        <div class="flex gap-4 flex-wrap">
          {
            data.url && (
              <a
                href={data.url}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-2 px-6 py-3 bg-violet-600 text-white font-medium rounded-lg hover:bg-violet-500 transition hover:scale-105"
              >
                <Icon name="external-link" class="w-5 h-5" />
                Ver proyecto
              </a>
            )
          }
          {
            data.repo && (
              <a
                href={data.repo}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-2 px-6 py-3 border border-white/20 text-white font-medium rounded-lg hover:bg-white/10 transition"
              >
                <Icon name="github" class="w-5 h-5" />
                Código
              </a>
            )
          }
        </div>
      </header>
      <section class="mb-12" transition:animate="slide">
        <div
          class="aspect-video rounded-xl overflow-hidden bg-white/5 border border-white/10 mb-12"
        >
          <ProjectImage
            image={data.image}
            slug={project.id}
            class="w-full h-full object-cover"
          />
        </div>
        <section class="mb-12" transition:animate="slide">
          <div
            class="grid grid-cols-2 md:grid-cols-4 border border-zinc-500/50 rounded-xl"
          >
            <div class="p-8 border-r border-zinc-500/50">
              <p class="text-gray-500 text-xs uppercase tracking-wider mb-1">
                Rol
              </p>
              <p class="text-white font-semibold">{data.role}</p>
            </div>
            <div class="p-8 border-r border-zinc-500/50">
              <p class="text-gray-500 text-xs uppercase tracking-wider mb-1">
                Duración
              </p>
              <p class="text-white font-semibold">{data.duration}</p>
            </div>
            <div class="p-8 border-r border-zinc-500/50">
              <p class="text-gray-500 text-xs uppercase tracking-wider mb-1">
                Cliente
              </p>
              <p class="text-white font-semibold">{data.client}</p>
            </div>
            <div class="p-8">
              <p class="text-gray-500 text-xs uppercase tracking-wider mb-1">
                Core Tech
              </p>
              <p class="text-white font-semibold">
                {data.coreTech}
              </p>
            </div>
          </div>
        </section>

        <section class="mb-12" transition:animate="slide">
          <div class="grid md:grid-cols-3 gap-8">
            <div class="col-span-2">
              <div class="flex place-items-center gap-4 mb-6">
                <div
                  class="w-12 h-0.5 bg-linear-to-r from-indigo-500 to-transparent"
                >
                </div>
                <h2 class="text-2xl font-bold">Sobre el Proyecto</h2>
              </div>
              <p class="text-gray-300 leading-relaxed mb-8">
                {data.fullDescription}
              </p>

              <GlassCard>
                <h3 class="text-xl font-bold mb-6">Retos y soluciones</h3>
                <div class="grid grid-cols-2 gap-6">
                  {
                    data.challenges.map((challenge, index) => (
                      <>
                        <div>
                          <p class="text-primary text-xs uppercase tracking-wider mb-3 font-semibold">
                            El reto
                          </p>
                          <p class="text-gray-400 text-sm">{challenge}</p>
                        </div>
                        <div>
                          <p class="text-indigo-400 text-xs uppercase tracking-wider mb-3 font-semibold">
                            La solución
                          </p>
                          <p class="text-gray-400 text-sm">
                            {data.solutions[index]}
                          </p>
                        </div>
                        {index < data.challenges.length - 1 && (
                          <div class="col-span-2 h-px bg-zinc-500/50" />
                        )}
                      </>
                    ))
                  }
                </div>
              </GlassCard>
            </div>

            <div>
              <div class="mb-6">
                <h3 class="text-lg font-semibold mb-4">Tech Stack</h3>
                <div class="flex flex-wrap gap-2">
                  {
                    data.tech.map((tech) => (
                      <span class="px-3 py-1 bg-indigo-500/10 text-indigo-300 text-sm rounded-xl group-hover:bg-indigo-500/20 group-hover:text-indigo-200 transition-all duration-300">
                        {tech}
                      </span>
                    ))
                  }
                </div>
              </div>
              <GlassCard class="p-8!">
                <h3 class="text-lg font-semibold mb-4">Funcionalidades</h3>
                <ul class="space-y-3">
                  {
                    data.features.map((feature) => (
                      <li class="flex items-start gap-3 text-gray-300">
                        <Icon
                          name="check-rounded"
                          class="w-5 h-5 text-primary shrink-0"
                        />
                        {feature}
                      </li>
                    ))
                  }
                </ul>
              </GlassCard>
            </div>
          </div>
        </section>
        <section
          class="text-center py-12 border-t border-white/10"
          transition:animate="slide"
        >
          <h2 class="text-3xl font-bold mb-4">Listo para verlo en acción?</h2>
          <p class="text-gray-400 mb-8">
            Explora el proyecto en vivo o revisa el código fuente
          </p>
          <div class="flex gap-4 justify-center flex-wrap">
            {
              data.url && (
                <a
                  href={data.url}
                  target="_blank"
                  rel="noopener"
                  class="inline-flex items-center gap-2 px-8 py-4 bg-violet-600 text-white font-medium rounded-lg hover:bg-violet-500 transition hover:scale-105"
                >
                  <Icon name="play" class="w-5 h-5" />
                  Explora la demo en vivo
                </a>
              )
            }
            {
              data.repo && (
                <a
                  href={data.repo}
                  target="_blank"
                  rel="noopener"
                  class="inline-flex items-center gap-2 px-8 py-4 border border-white/20 text-white font-medium rounded-lg hover:bg-white/10 transition"
                >
                  <Icon name="github" class="w-5 h-5" />
                  Revisa el código
                </a>
              )
            }
          </div>
        </section>
      </section>
    </div>
  </article>
</Layout>
