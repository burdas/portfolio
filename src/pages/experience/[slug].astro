---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import ExperienceBreadcrumb from "@/src/components/Experience/ExperienceBreadcrumb.astro";
import ExperienceHeader from "@/src/components/Experience/ExperienceHeader.astro";
import ExperienceContent from "@/src/components/Experience/ExperienceContent.astro";
import ExperienceSidebar from "@/src/components/Experience/ExperienceSidebar.astro";
import ExperienceFooter from "@/src/components/Experience/ExperienceFooter.astro";

export async function getStaticPaths() {
  const experience = await getCollection("experience");
  return experience.map((job) => ({
    params: { slug: job.slug },
    props: { job },
  }));
}

const { job } = Astro.props;
const { data: jobData } = job;

const experience = await getCollection("experience");
const sortedExperience = experience.sort((a, b) => a.data.order - b.data.order);
const currentIndex = sortedExperience.findIndex((j) => j.slug === job.slug);
const prevJob = currentIndex > 0 ? sortedExperience[currentIndex - 1] : null;
const nextJob =
  currentIndex < sortedExperience.length - 1
    ? sortedExperience[currentIndex + 1]
    : null;
---

<Layout
  title={`${jobData.role} - ${jobData.company}`}
  description={jobData.description}
  ogImage={`/og/${job.slug}.png`}
  ogImageWidth="1200"
  ogImageHeight="630"
>
  <article
    class="min-h-screen pt-8 sm:pt-24 pb-16 bg-black text-gray-300 font-['JetBrains_Mono']"
  >
    <div class="max-w-6xl mx-auto px-6">
      <ExperienceBreadcrumb company={jobData.company} />

      <ExperienceHeader
        company={jobData.company}
        role={jobData.role}
        logo={jobData.logo}
        type={jobData.type}
        period={jobData.period}
        location={jobData.location}
        siteUrl={jobData.siteUrl}
      />

      <ExperienceContent
        description={jobData.description}
        highlights={jobData.detailedHighlights || jobData.highlights}
      >
        <ExperienceSidebar
          slot="sidebar"
          technologies={jobData.technologies}
          keyProjects={jobData.keyProjects}
        />
      </ExperienceContent>

      <ExperienceFooter prevJob={prevJob} nextJob={nextJob} />
    </div>
  </article>
</Layout>

<style>
  /* Optional: Custom scrollbar for tech badges if they overflow */
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
